        {
          "name": "POST Login SuperAdmin (Auto Simpan Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('✅ Token tersimpan ke variabel koleksi: ' + res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
