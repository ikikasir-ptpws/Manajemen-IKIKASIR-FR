datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model Role {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  menuAccess  RoleMenuAccess?
  users       User[]

  @@map("roles")
}

model RoleMenuAccess {
  id                String   @id @default(uuid())
  roleId            String   @unique
  role              Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  dashboard         Boolean  @default(false)
  manajemenPengguna Boolean  @default(false)
  manajemenRole     Boolean  @default(false)
  manajemenPromo    Boolean  @default(false)
  kelolaPaket       Boolean  @default(false)
  calonClient       Boolean  @default(false)
  semuaPelanggan    Boolean  @default(false)
  langganan         Boolean  @default(false)
  expired           Boolean  @default(false)
  arusKas           Boolean  @default(false)
  labaRugi          Boolean  @default(false)
  neraca            Boolean  @default(false)
  laporanPenjualan  Boolean  @default(false)
  landingPage       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("role_menu_accesses")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("SUPERADMIN")
  roleId    String?
  roleRef   Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  phone     String?
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([roleId])
  @@map("users")
}

model Package {
  id             String   @id @default(uuid())
  name           String
  description    String?  @default("")
  price          Float    @default(0)
  period         String   @default("/bulan")
  isConsultation Boolean  @default(false)
  features       String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customers             Customer[]
  subscriptionHistories SubscriptionHistory[]
  leads                 Lead[]

  @@index([name])
  @@index([isActive])
  @@map("packages")
}

model Customer {
  id                    String                @id @default(uuid())
  name                  String
  businessName          String
  email                 String                @unique
  phone                 String
  address               String?               @default("")
  packageId             String?
  package               Package?              @relation(fields: [packageId], references: [id], onDelete: SetNull)
  status                String                @default("ACTIVE") // ACTIVE, EXPIRED, SUSPENDED
  startedAt             DateTime              @default(now())
  expiresAt             DateTime
  notes                 String?               @default("")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  subscriptionHistories SubscriptionHistory[]

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("customers")
}

model SubscriptionHistory {
  id                 String    @id @default(uuid())
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  packageId          String?
  package            Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageName        String
  amount             Float     @default(0)
  billingCycleMonths Int       @default(1)
  paymentMethod      String    @default("QRIS")
  paymentStatus      String    @default("PAID") // PAID, PENDING, FAILED
  notes              String?   @default("")
  startedAt          DateTime  @default(now())
  expiresAt          DateTime
  createdAt          DateTime  @default(now())

  @@index([customerId])
  @@index([packageId])
  @@map("subscription_histories")
}

model Lead {
  id                     String         @id @default(uuid())
  no                     Int            @default(autoincrement())
  name                   String
  businessName           String
  businessCategory       String?        @default("")
  businessType           String?        @default("")
  phone                  String
  email                  String
  address                String?        @default("")
  status                 String         @default("New") // New, Contacted, Follow Up, Interested, Converted, Lost
  source                 String         @default("Website") // Website, Google Form, Instagram, WhatsApp, Facebook Ads, Referral, Direct / Walk-in
  registrationDate       DateTime       @default(now())
  lastFollowUp           DateTime       @default(now())
  packageInterest        String?        @default("Basic") // Basic, Pro, Add on, Custom / IT One
  packageId              String?
  package                Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  estimatedDeal          Float          @default(250000)
  notes                  String?        @default("")
  followUpSchedule       String?        @default("Hari ini")

  // Referral
  referralCode           String?
  referredByCustomerId   String?
  referredByCustomerName String?
  referredByBusinessName String?

  // Survey / Kuesioner
  city                   String?        @default("")
  outletCount            String?        @default("")
  employeeAppCount       String?        @default("")
  employeeCount          String?        @default("")
  currentRecordingMethod String?        @default("")
  neededFeatures         String[]       @default([])
  otherNeededFeature     String?        @default("")
  specialNeed            String?        @default("")
  knownFrom              String?        @default("")
  otherKnownFrom         String?        @default("")
  consentAgreed          Boolean        @default(true)

  // Workflow Finance
  paymentProofUrl        String?        @default("")
  paymentStatus          String         @default("unpaid") // unpaid, pending_verification, verified, rejected
  paymentAmount          Float?         @default(0)
  paymentDate            DateTime?
  paymentMethod          String?        @default("")
  paymentVerifiedAt      DateTime?
  paymentVerifiedBy      String?        @default("")
  paymentNotes           String?        @default("")

  // Workflow Teknisi
  technicianStatus       String?        @default("") // pending_setup, in_progress, completed
  technicianAssignedTo   String?        @default("")
  appUsername            String?        @default("")
  appPassword            String?        @default("")
  appDownloadUrl         String?        @default("")
  guideBookUrl           String?        @default("")
  rentalAgreementNumber  String?        @default("")
  rentalAgreementDate    String?        @default("")
  emailIssueReported     Boolean        @default(false)
  emailIssueNotes        String?        @default("")
  setupCompletedAt       DateTime?
  appExpiredDate         DateTime?

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  followUps              LeadFollowUp[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@map("leads")
}

model LeadFollowUp {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  channel   String   @default("Sistem") // WhatsApp, Telepon, Email, Meeting, Sistem
  notes     String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_follow_ups")
}

